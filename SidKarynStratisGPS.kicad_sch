	(text "SCK = clock from STM32 to device\nMOSI = data from STM32 to device\nMISO = data from device to STM32\nCS = Chip Select: selects which device the STM32 talks to\n\nSPI1 = shared by barometer and IMU\nSPI2 = microSD card only\nSPI4 = LoRa radio only\n\nBARO_CS_N = selects barometer\nIMU_CS_A = selects IMU accelerometer\nIMU_CS_G = selects IMU gyroscope\nSD_CS_N = selects microSD card\nAll chip selects above are active low.\n\nI2C = two-wire communication with GPS\nI2C_SCL = clock from STM32 to GPS\nI2C_SDA = data in both directions"
		(exclude_from_sim no)
		(at 303.784 216.662 0)
		(effects
			(font
				(size 1.143 1.143)
				(thickness 0.1429)
			)
			(justify left top)
		)
		(uuid "cbee5ddb-ff66-4be4-948b-ba61ff3e9f29")
	)
